# Template only: the Dart server reads process environment variables directly.
# Local OCR only: no cloud API key is required.
CURATOR_TESSERACT_BIN=tesseract
CURATOR_OCR_LANGUAGE=eng

# Target AVIF -> alpha-preserving PNG, server only (brew install libavif).
# Use an absolute executable path if the IDE does not inherit Homebrew PATH.
CURATOR_AVIFDEC_BIN=avifdec

# Optional: only an operator-owned key with Target-approved server API access.
# Without this, RedSky is never called. A copied website key is not permission.
# CURATOR_TARGET_REDSKY_KEY=

# Safe local-development defaults for `flutter run -d chrome --web-port=3000`.
CURATOR_PROXY_HOST=127.0.0.1
CURATOR_PROXY_PORT=8787
CURATOR_CORS_ALLOW_ORIGIN=http://localhost:3000
CURATOR_ALLOW_UNAUTHENTICATED_LOOPBACK=true

# Backend-owned documents and generated assets (default: ./assets).
# In a deployment, point this at persistent storage, not the Flutter bundle.
# CURATOR_ASSETS_DIR=/var/data/curator-assets

# In production, choose an authentication mode and keep the server private.
# CURATOR_PROXY_TOKEN=
# CURATOR_TRUSTED_AUTH_HEADER=X-Curator-Authenticated

# Optional resource controls (the defaults are documented in usage.md).
# CURATOR_MAX_BODY_BYTES=12582912
# CURATOR_MAX_IMAGE_BYTES=8388608
# CURATOR_MAX_CATALOG_ITEMS=50
# Keep this below the Flutter gateway's 60-second request timeout.
# CURATOR_UPSTREAM_TIMEOUT_SECONDS=45
# CURATOR_RATE_LIMIT_PER_MINUTE=60

# CURATOR_BACKEND_URL is intentionally absent: it is a public Flutter
# --dart-define, not a server secret or a value read from this file.
